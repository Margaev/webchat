apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: gitops
  namespace: ${argocd_namespace}
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  ignoreApplicationDifferences: # ignoring here as image tags are controlled by image updater
    - jsonPointers:
        - /spec/source/kustomize/images
  generators:
    - git:
        repoURL: https://github.com/Margaev/webchat.git
        revision: HEAD
        directories:
          - path: deploy/manifests/*
          - path: deploy/manifests/environments*
            exclude: true
  template:
    metadata:
      name: "{{.path.basename}}"
    spec:
      project: "webchat"
      source:
        repoURL: https://github.com/Margaev/webchat.git
        targetRevision: HEAD
        path: "{{.path.path}}"
      destination:
        server: https://kubernetes.default.svc
        namespace: "{{.path.basename}}"
      syncPolicy:
        automated:
          enabled: true
          prune: true
          selfHeal: true
        syncOptions:
          - CreateNamespace=true
